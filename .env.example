# EmailJS Configuration for Contact Form
# Get these credentials from your EmailJS dashboard: https://dashboard.emailjs.com

# 1. Service ID from "Email Services" tab (e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Template ID from "Email Templates" tab (e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. Public Key from "Account" -> "API Keys" (e.g. xxxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# 4. Configured Recipient Email (Must match your verified recipient email)
VITE_EMAILJS_TO_EMAIL=tinu.sunny@gmail.com
